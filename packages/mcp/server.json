{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.silvanexum/silvanexum",
  "title": "Silvanexum",
  "description": "Spend control for AI agents - cost attribution, budget caps, and signed runs as MCP tools.",
  "version": "0.6.3",
  "repository": {
    "url": "https://github.com/silvanexum/Silvanexum-sdk",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@silvanexum/mcp",
      "version": "0.6.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SILVANEXUM_API_KEY",
          "description": "A scoped Silvanexum API key (read+run recommended).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "SILVANEXUM_BASE_URL",
          "description": "API base URL (default https://api.silvanexum.com).",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "silvanexum-mcp",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SILVANEXUM_API_KEY",
          "description": "A scoped Silvanexum API key (read+run recommended).",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
