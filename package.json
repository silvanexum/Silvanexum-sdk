{
  "name": "silvanexum-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Silvanexum SDKs, MCP server, and package distribution. Clients are generated from the backend's src/shared/* Zod contracts (single source of truth) — see packages/codegen.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "generate": "tsx packages/codegen/src/index.ts",
    "generate:check": "tsx packages/codegen/src/index.ts --check",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  }
}
